# ─── Obrigatórias (a API não sobe sem elas) ─────────────────────────────
# PostgreSQL — database push_site
DATABASE_URL=postgres://usuario:senha@host:5432/push_site
# Segredo do JWT do painel (mínimo 32 caracteres; gere com: openssl rand -hex 32)
JWT_SECRET=
# Primeiro admin do painel — criado automaticamente na primeira subida
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ─── Servidor ───────────────────────────────────────────────────────────
PORT=3000
# Origens liberadas no CORS, separadas por vírgula (site + painel)
FRONTEND_URL=https://pushagencia.com.br,https://www.pushagencia.com.br
# URL do painel usada nos links das notificações (padrão: primeira FRONTEND_URL)
PANEL_URL=https://pushagencia.com.br
# Duração do login do painel
JWT_EXPIRES_IN=8h
# Fuso usado para agrupar os relatórios por dia
TZ_REPORTS=America/Sao_Paulo
# "true" se o Postgres exigir SSL (ex.: banco gerenciado externo)
DATABASE_SSL=false
# Roda as migrations ao iniciar (idempotentes). Use "false" para rodar só via npm run migrate
RUN_MIGRATIONS_ON_START=true
# Salt do hash de IP das sessões (padrão: JWT_SECRET)
IP_HASH_SALT=

# ─── Meta Conversions API ───────────────────────────────────────────────
META_PIXEL_ID=
# Token gerado em Gerenciador de Eventos → Configurações → API de Conversões
META_CAPI_TOKEN=
# Opcional: código da aba "Testar eventos" (remova em produção)
META_TEST_EVENT_CODE=
META_API_VERSION=v21.0

# ─── Notificação de lead novo ───────────────────────────────────────────
# Webhook (CRM / automação de WhatsApp). Recebe POST JSON { evento: "lead.criado", lead: {...} }
LEAD_WEBHOOK_URL=
# Opcional: assina o corpo com HMAC-SHA256 no header X-Push-Signature
LEAD_WEBHOOK_SECRET=
# E-mail (opcional): destinatários separados por vírgula + SMTP
LEAD_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PUSH <no-reply@pushagencia.com.br>

# ─── CMS / publicação ───────────────────────────────────────────────────
# Webhook de deploy do front no Coolify (Application → Webhooks → Deploy Webhook).
# O botão "Publicar no site" do painel chama esta URL para regerar o HTML estático (SEO).
SITE_DEPLOY_HOOK_URL=
# Token de API do Coolify (enviado como Bearer), se o webhook exigir
SITE_DEPLOY_HOOK_TOKEN=
SITE_DEPLOY_HOOK_METHOD=GET
